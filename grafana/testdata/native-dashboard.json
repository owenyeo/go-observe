{
  "apiVersion": "dashboard.grafana.app/v2",
  "kind": "Dashboard",
  "metadata": {
    "name": "checkout-native",
    "namespace": "default"
  },
  "spec": {
    "title": "Checkout diagnostic notes",
    "description": "Native dashboard compatibility fixture.",
    "cursorSync": "Off",
    "editable": true,
    "liveNow": false,
    "preload": false,
    "tags": [],
    "annotations": [],
    "variables": [],
    "links": [],
    "timeSettings": {
      "timezone": "browser",
      "from": "now-1h",
      "to": "now",
      "autoRefresh": "30s",
      "autoRefreshIntervals": [
        "5s",
        "10s",
        "30s",
        "1m",
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ],
      "hideTimepicker": false,
      "fiscalYearStartMonth": 0
    },
    "preferences": {
      "layout": {
        "kind": "GridLayout",
        "spec": {
          "items": []
        }
      }
    },
    "elements": {
      "notes": {
        "kind": "Panel",
        "spec": {
          "id": 1,
          "title": "First checks",
          "description": "Start with service metrics.",
          "links": [],
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "transformations": [],
              "queryOptions": {}
            }
          },
          "vizConfig": {
            "kind": "VizConfig",
            "group": "text",
            "version": "13.1.3",
            "spec": {
              "options": {
                "content": "Inspect errors and dependencies.",
                "mode": "markdown"
              },
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              }
            }
          }
        }
      }
    },
    "layout": {
      "kind": "GridLayout",
      "spec": {
        "items": [
          {
            "kind": "GridLayoutItem",
            "spec": {
              "x": 0,
              "y": 0,
              "width": 24,
              "height": 5,
              "element": {
                "kind": "ElementReference",
                "name": "notes"
              }
            }
          }
        ]
      }
    }
  }
}
